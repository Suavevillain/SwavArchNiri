layout {

    focus-ring {
        active-color   "#ffb956"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb956"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb956"
        inactive-color "#633f00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb95680"
    }
}

recent-windows {
    highlight {
        active-color "#ffb956"
        urgent-color "#ffb4ab"
    }
}
