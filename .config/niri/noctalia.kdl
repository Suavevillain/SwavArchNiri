layout {

    focus-ring {
        active-color   "#58dbc2"
        inactive-color "#101413"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#58dbc2"
        inactive-color "#101413"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#58dbc2"
        inactive-color "#005045"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#58dbc280"
    }
}

recent-windows {
    highlight {
        active-color "#58dbc2"
        urgent-color "#ffb4ab"
    }
}
